# Copiar a .env.local y completar con los datos de tu proyecto de Supabase.
# Sin estas dos variables, la app funciona solo en este navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANONIMA
# Dejar en 0 mientras no haya cuentas de usuario.
VITE_CON_CUENTAS=0
